---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/film.css";
import Lightbox from "../components/Lightbox.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import { site, pageDescriptions, isPreview } from '../data/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const description = Astro.props.description ?? pageDescriptions[currentPath] ?? pageDescriptions['/'];
const noindex = Astro.props.noindex || isPreview;
const canonical = new URL(currentPath, site.url);
const pageTitle = `${title} | ${site.name}`;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: site.name, url: site.url, logo: new URL('/logo-avdan.svg', site.url).href,
  email: 'avdan.producciones@gmail.com',
  sameAs: ['https://www.instagram.com/avdan.prod/', 'https://www.youtube.com/channel/UCySStgJVu23f-DTDuiiPX9Q'],
};
const navigation = [
  { href: "/", label: "Portafolio" },
  { href: "/servicios/", label: "Servicios" },
  { href: "/sobre/", label: "Acerca de" },
  { href: "/contacto/", label: "Contacto" },
];
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={description}
    />
    <title>{pageTitle}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.image, site.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(site.image, site.url)} />
    <link rel="icon" href="/logo-avdan.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/akira-expanded-demo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-variable.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <ClientRouter />
  </head>
  <body data-page={currentPath}>
    <LoadingScreen />
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand" aria-label="AVDAN, inicio"
          ><img
            class="brand__logo"
            src="/logo-avdan.svg"
            alt="AVDAN"
            width="119"
            height="84"
            fetchpriority="high"
          /></a
        >
        <nav class="site-nav" aria-label="Navegación principal">
          {navigation.map(({ href, label }) => (
            <a class:list={{ active: currentPath === href }} href={href} aria-current={currentPath === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <details class="mobile-menu">
          <summary class="mobile-menu__toggle" aria-label="Menú de navegación">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </summary>
          <div class="mobile-menu__backdrop" aria-hidden="true"></div>
          <nav class="mobile-menu__panel" aria-label="Navegación móvil">
            {navigation.map(({ href, label }) => (
              <a class:list={{ active: currentPath === href }} href={href} aria-current={currentPath === href ? "page" : undefined}>{label}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <div class="darkroom-light" aria-hidden="true"></div>
    <main id="contenido" tabindex="-1" transition:animate="fade"><slot /></main>

    <footer class="site-footer">
      <div class="footer-intro" data-reveal>
        <p class="footer-title">
          Demosle vida<br />a <span class="idea-highlight">tu idea</span>
        </p>
      </div>
      <div class="footer-contact" data-reveal style="--delay:120ms">
        <p class="footer-label">Contacto</p>
        <a class="footer-cta" href="/contacto/"
          >Cuéntanos sobre tu proyecto <span aria-hidden="true">↗</span></a
        >
        <a class="footer-email" href="mailto:avdan.producciones@gmail.com"
          ><span>avdan.producciones@<wbr />gmail.com</span> <span aria-hidden="true">↗</span></a
        >
      </div>
      <div class="footer-external" data-reveal style="--delay:240ms">
        <p class="footer-label">Redes sociales</p>
        <nav class="footer-social" aria-label="Redes sociales">
          <a
            class="footer-social__instagram"
            href="https://www.instagram.com/avdan.prod/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg
              class="social-mark social-mark--instagram"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><defs
                ><linearGradient
                  id="ig-gradient"
                  gradientUnits="userSpaceOnUse"
                  x1="3"
                  y1="21"
                  x2="21"
                  y2="3"
                  ><stop offset="0" stop-color="#feda75"></stop><stop
                    offset=".3"
                    stop-color="#fa7e1e"></stop><stop
                    offset=".55"
                    stop-color="#d62976"></stop><stop
                    offset=".8"
                    stop-color="#962fbf"></stop><stop
                    offset="1"
                    stop-color="#4f5bd5"></stop></linearGradient
                ></defs
              ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle
                cx="12"
                cy="12"
                r="4.2"></circle><circle
                cx="17.4"
                cy="6.7"
                r="1"
                class="social-mark__fill"></circle></svg
            >
            <span>Instagram</span><span aria-hidden="true">↗</span>
          </a>
          <a
            class="footer-social__youtube"
            href="https://www.youtube.com/channel/UCySStgJVu23f-DTDuiiPX9Q"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
          >
            <svg class="social-mark" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M21 8.2a2.8 2.8 0 0 0-2-2C17.2 5.7 12 5.7 12 5.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.5 12 29 29 0 0 0 3 15.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.8 29 29 0 0 0-.5-3.8Z"
              ></path><path d="m10 9 5 3-5 3V9Z" class="social-mark__fill"
              ></path></svg
            >
            <span>YouTube</span><span aria-hidden="true">↗</span>
          </a>
          <a
            class="footer-social__whatsapp"
            href="https://wa.me/56921882471"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
          >
            <svg class="social-mark" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.7-4.1A8.5 8.5 0 1 1 20.5 11.5Z"
              ></path><path
                d="M8.2 8.5c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c.7 1.3 1.7 2.2 3 2.8l.5-.5c.2-.2.4-.2.6-.1l1.6.7c.3.1.4.3.3.6-.2.8-.8 1.4-1.6 1.5-1.3.1-3.2-.8-4.7-2.2-1.4-1.3-2.3-3.1-2.2-4.4.1-.5.4-1 .7-1.3Z"
                class="social-mark__fill"></path></svg
            >
            <span>WhatsApp</span><span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
      <div class="footer-bottom" data-reveal>
        <small>© {new Date().getFullYear()} AVDAN</small>
      </div>
    </footer>
    <button class="scroll-top" type="button" aria-label="Volver arriba" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M5 15l7-7 7 7"></path></svg
      >
    </button>
    <a
      class="floating-whatsapp is-hidden"
      href="https://wa.me/56921882471"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escribir a AVDAN por WhatsApp"
      aria-hidden="true"
      tabindex="-1"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.7-4.1A8.5 8.5 0 1 1 20.5 11.5Z"
        ></path><path
          d="M8.2 8.5c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c.7 1.3 1.7 2.2 3 2.8l.5-.5c.2-.2.4-.2.6-.1l1.6.7c.3.1.4.3.3.6-.2.8-.8 1.4-1.6 1.5-1.3.1-3.2-.8-4.7-2.2-1.4-1.3-2.3-3.1-2.2-4.4.1-.5.4-1 .7-1.3Z"
          class="floating-whatsapp__fill"></path></svg
      >
    </a>
    <Lightbox />
  </body>
</html>

<script>
  let revealObserver: IntersectionObserver | undefined;
  let repeatObserver: IntersectionObserver | undefined;
  const revealSections = () => {
    revealObserver?.disconnect();
    repeatObserver?.disconnect();
    const elements = document.querySelectorAll<HTMLElement>(
      "[data-reveal]:not([data-reveal-repeat])",
    );

    if (!("IntersectionObserver" in window)) {
      elements.forEach((element) => element.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          currentObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.12 },
    );
    revealObserver = observer;

    elements.forEach((element) => observer.observe(element));

    // Estos bloques repiten su animacion cada vez que entran en pantalla.
    const repeat = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) =>
          entry.target.classList.toggle("is-visible", entry.isIntersecting),
        );
      },
      { threshold: 0.12 },
    );
    repeatObserver = repeat;
    document
      .querySelectorAll<HTMLElement>("[data-reveal-repeat]")
      .forEach((element) => repeat.observe(element));
  };

  document.documentElement.classList.add("reveal-enabled");
  document.addEventListener("astro:after-swap", () =>
    document.documentElement.classList.add("reveal-enabled"),
  );
  revealSections();
  document.addEventListener("astro:page-load", revealSections);
  document.addEventListener("astro:before-swap", () => {
    revealObserver?.disconnect();
    repeatObserver?.disconnect();
  });

  const syncHeaderHeight = () => {
    const header = document.querySelector<HTMLElement>(".site-header");
    if (header)
      document.documentElement.style.setProperty(
        "--header-h",
        `${header.offsetHeight}px`,
      );
  };

  let lastScrollY = window.scrollY;
  let scrollAnchor = lastScrollY;
  const updateHeader = () => {
    const header = document.querySelector<HTMLElement>(".site-header");
    if (!header) return;
    const currentScrollY = Math.max(0, window.scrollY);
    if (currentScrollY <= 0 || header.querySelector(".mobile-menu[open]")) {
      header.classList.remove("is-hidden");
      scrollAnchor = currentScrollY;
    } else {
      if ((currentScrollY - lastScrollY) * (lastScrollY - scrollAnchor) < 0)
        scrollAnchor = lastScrollY;
      if (Math.abs(currentScrollY - scrollAnchor) >= 8) {
        header.classList.toggle(
          "is-hidden",
          currentScrollY > scrollAnchor && currentScrollY > header.offsetHeight,
        );
        scrollAnchor = currentScrollY;
      }
    }
    lastScrollY = currentScrollY;
  };

  const updateScrollTop = () => {
    const button = document.querySelector<HTMLButtonElement>(".scroll-top");
    const whatsapp = document.querySelector<HTMLAnchorElement>(".floating-whatsapp");
    const footer = document.querySelector<HTMLElement>(".site-footer");
    const footerVisible = footer ? footer.getBoundingClientRect().top < window.innerHeight : false;
    const scrolled = window.scrollY > 400;
    if (button) {
      const visible = scrolled && !footerVisible;
      button.hidden = false;
      button.classList.toggle("is-visible", visible);
      button.tabIndex = visible ? 0 : -1;
    }
    if (whatsapp) {
      const visible = !footerVisible && scrolled;
      whatsapp.classList.toggle("is-hidden", !visible);
      whatsapp.setAttribute("aria-hidden", String(!visible));
      whatsapp.tabIndex = visible ? 0 : -1;
    }
  };

  // El script se carga una sola vez; el boton se vuelve a enlazar tras cada navegacion.
  let scrollFrame = 0;
  const scheduleScrollUpdate = () => {
    if (scrollFrame) return;
    scrollFrame = requestAnimationFrame(() => {
      scrollFrame = 0;
      updateHeader();
      updateScrollTop();
    });
  };
  window.addEventListener("scroll", scheduleScrollUpdate, { passive: true });
  window.addEventListener("resize", syncHeaderHeight);
  window.addEventListener("resize", scheduleScrollUpdate);
  window.addEventListener("resize", () => {
    if (window.matchMedia("(max-width: 900px)").matches) return;
    const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu[open]");
    if (menu) menu.open = false;
  });
  document.addEventListener("click", (event) => {
    const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu[open]");
    if (!menu || !(event.target instanceof Node)) return;
    if (!menu.contains(event.target) || (event.target instanceof Element && event.target.closest("a, .mobile-menu__backdrop"))) menu.open = false;
  });
  let outsideMenuTouch: { x: number; y: number } | undefined;
  document.addEventListener("touchstart", (event) => {
    const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu[open]");
    const target = event.target instanceof Element ? event.target : null;
    outsideMenuTouch = menu && event.touches.length === 1 &&
      !target?.closest(".mobile-menu__panel, .mobile-menu__toggle")
      ? { x: event.touches[0].clientX, y: event.touches[0].clientY }
      : undefined;
  }, { passive: true });
  document.addEventListener("touchmove", (event) => {
    if (!outsideMenuTouch || event.touches.length !== 1) return;
    const touch = event.touches[0];
    if (Math.hypot(touch.clientX - outsideMenuTouch.x, touch.clientY - outsideMenuTouch.y) < 10) return;
    const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu[open]");
    if (menu) menu.open = false;
    outsideMenuTouch = undefined;
  }, { passive: true });
  document.addEventListener("touchend", () => { outsideMenuTouch = undefined; }, { passive: true });
  document.addEventListener("touchcancel", () => { outsideMenuTouch = undefined; }, { passive: true });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu[open]");
    if (menu) {
      menu.open = false;
      menu.querySelector<HTMLElement>("summary")?.focus();
    }
  });
  document.addEventListener("astro:page-load", () => {
    syncHeaderHeight();
    lastScrollY = window.scrollY;
    scrollAnchor = lastScrollY;
    document
      .querySelector<HTMLElement>(".site-header")
      ?.classList.remove("is-hidden");
    updateScrollTop();
    document
      .querySelector<HTMLButtonElement>(".scroll-top")
      ?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' }),
      );
  });
</script>
