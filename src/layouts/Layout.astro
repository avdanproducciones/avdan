---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AVDAN: portafolio audiovisual, servicios y contacto." />
    <title>{title} · AVDAN</title>
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label="AVDAN, inicio">AVDAN<span aria-hidden="true"></span></a>
      <nav aria-label="Navegación principal">
        <a class:list={{ active: currentPath === '/' }} href="/">Portafolio</a>
        <a class:list={{ active: currentPath === '/servicios/' }} href="/servicios/">Servicios</a>
        <a class:list={{ active: currentPath === '/sobre/' }} href="/sobre/">Acerca de</a>
        <a class:list={{ active: currentPath === '/contacto/' }} href="/contacto/">Contacto</a>
      </nav>
    </header>
    <main transition:animate="fade"><slot /></main>
    <footer class="site-footer">
      <div class="footer-intro">
        <p class="footer-title">Hagamos algo<br />memorable.</p>
      </div>
      <div class="footer-contact">
        <p class="footer-label">Contacto</p>
        <a class="footer-cta" href="/contacto/">Cuéntanos sobre tu proyecto <span aria-hidden="true">↗</span></a>
        <a class="footer-email" href="mailto:avdan.producciones@gmail.com">avdan.producciones@gmail.com <span aria-hidden="true">↗</span></a>
      </div>
      <div class="footer-external">
        <p class="footer-label">También puedes encontrarnos en</p>
        <nav class="footer-social" aria-label="Redes sociales">
          <a href="#" aria-label="Instagram">
            <svg class="social-mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.7" r="1" class="social-mark__fill" /></svg>
            <span>Instagram</span><span aria-hidden="true">↗</span>
          </a>
          <a href="#" aria-label="YouTube">
            <svg class="social-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8.2a2.8 2.8 0 0 0-2-2C17.2 5.7 12 5.7 12 5.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.5 12 29 29 0 0 0 3 15.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.8 29 29 0 0 0-.5-3.8Z" /><path d="m10 9 5 3-5 3V9Z" class="social-mark__fill" /></svg>
            <span>YouTube</span><span aria-hidden="true">↗</span>
          </a>
          <a href="#" aria-label="WhatsApp">
            <svg class="social-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.7-4.1A8.5 8.5 0 1 1 20.5 11.5Z" /><path d="M8.2 8.5c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c.7 1.3 1.7 2.2 3 2.8l.5-.5c.2-.2.4-.2.6-.1l1.6.7c.3.1.4.3.3.6-.2.8-.8 1.4-1.6 1.5-1.3.1-3.2-.8-4.7-2.2-1.4-1.3-2.3-3.1-2.2-4.4.1-.5.4-1 .7-1.3Z" class="social-mark__fill" /></svg>
            <span>WhatsApp</span><span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
      <div class="footer-bottom">
        <small>© {new Date().getFullYear()} AVDAN</small>
        <small>Hecho para contar historias</small>
      </div>
    </footer>
  </body>
</html>

<script>
  const revealSections = () => {
    const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');

    if (!('IntersectionObserver' in window)) {
      elements.forEach((element) => element.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: 0.12 });

    elements.forEach((element) => observer.observe(element));
  };

  document.documentElement.classList.add('reveal-enabled');
  revealSections();
  document.addEventListener('astro:page-load', revealSections);
</script>
