---
---
<dialog id="lightbox" class="image-dialog" aria-label="Imagen ampliada">
 <div class="image-dialog__content">
   <div class="image-dialog__header">
      <button class="image-dialog__close" type="button" aria-label="Cerrar">
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="zoom-frame" data-lightbox-image hidden><img alt="" /></div>
    <video class="lightbox__video" data-lightbox-video controls hidden></video>
    <div class="portfolio-slot-dialog__preview" data-lightbox-placeholder hidden aria-hidden="true"><span>+</span></div>
  </div>
</dialog>

<script>
  import { attachZoom, resetZoom } from '../scripts/zoom';

  // Un solo manejador delegado: cualquier elemento con data-lightbox abre este popup.
  if (!(window as any).__lightboxReady) {
    (window as any).__lightboxReady = true;

    const open = (trigger: HTMLElement) => {
      const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
      if (!dialog) return;
      const frame = dialog.querySelector<HTMLElement>('[data-lightbox-image]')!;
      const video = dialog.querySelector<HTMLVideoElement>('[data-lightbox-video]')!;
      const placeholder = dialog.querySelector<HTMLElement>('[data-lightbox-placeholder]')!;
      const img = frame.querySelector('img')!;
      const src = trigger.dataset.lightbox ?? '';
      const kind = trigger.dataset.lightboxType ?? 'image';

      frame.hidden = !(src && kind === 'image');
      video.hidden = !(src && kind === 'video');
      placeholder.hidden = Boolean(src);
      if (!frame.hidden) {
        img.src = src;
        img.alt = trigger.dataset.lightboxTitle ?? '';
        resetZoom(frame);
        attachZoom(frame, () => dialog.close());
      }
      if (!video.hidden) video.src = src;
      dialog.showModal();
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const trigger = target.closest<HTMLElement>('[data-lightbox]');
      if (trigger) {
        event.preventDefault();
        open(trigger);
        return;
      }
      const dialog = target.closest<HTMLDialogElement>('#lightbox');
      if (!dialog) return;
      if (target === dialog || target.closest('.image-dialog__close')) dialog.close();
      else if (target.closest('.image-dialog__content') && !target.closest('.zoom-frame, video, .image-dialog__header')) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      if ((event.key === 'Enter' || event.key === ' ') && (event.target as HTMLElement).matches?.('[data-lightbox][role="button"]')) {
        event.preventDefault();
        (event.target as HTMLElement).click();
      }
    });

    document.addEventListener('close', (event) => {
      const dialog = event.target as HTMLElement;
      if (dialog.id !== 'lightbox') return;
      const video = dialog.querySelector<HTMLVideoElement>('[data-lightbox-video]');
      video?.pause();
      video?.removeAttribute('src');
      const frame = dialog.querySelector<HTMLElement>('[data-lightbox-image]');
      if (frame) resetZoom(frame);
    }, true);
  }
</script>
