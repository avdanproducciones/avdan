---
const photos = [
  { title: "Claudio Parra", src: "/media/projects/seleccion-01.webp" },
  { title: "Flor de Rap", src: "/media/projects/seleccion-07.webp" },
  { title: "Tata Barahona", src: "/media/projects/seleccion-10.webp" },
  { title: "Sigrid Alegría", src: "/media/projects/seleccion-06.webp" },
  { title: "Fiesta Chilenidad", src: "/media/projects/seleccion-03.webp" },
  { title: "Invierno en Escena", src: "/media/projects/seleccion-05.webp" },
  { title: "Fiesta San Pedro", src: "/media/projects/seleccion-04.webp" },
  {
    title: "70 Aniversario Orquesta",
    src: "/media/projects/seleccion-02.webp",
  },
  { title: "Matrimonio", src: "/media/projects/seleccion-08.webp" },
  { title: "Matrimonio", src: "/media/projects/seleccion-09.webp" },
];
const strings = [photos.slice(0, 5), photos.slice(5, 10)];
const videos = [
  { title: "Memorias del Mar", youtubeId: "hcbyyc0O8Ng", size: "large" },
  { title: "SPOT T.G", youtubeId: "ttPV0iTUSW8", size: "standard" },
];
---

<section
  class="portfolio-slots garland-section"
  id="seleccion"
  aria-labelledby="garland-title"
>
  <div class="section-heading section-heading--center" data-reveal>
    <i class="bulb" style="--x: 12%; --cord: 20px; --d: -3s" aria-hidden="true"
    ></i>
    <h2 id="garland-title">Seleccion</h2>
    <p class="darkroom-sign" aria-hidden="true"><i></i>Revelando…</p>
  </div>

  <div class="garland-scroll">
    {
      strings.map((row, rowIndex) => (
        <div class="garland" style={`--row:${rowIndex}`} data-reveal>
          <svg class="garland__thread" aria-hidden="true">
            <path d="" fill="none" />
          </svg>
          {row.map((photo, index) => (
            <button
              class="garland__item"
              type="button"
              style={`--i:${index}`}
              aria-label={`Abrir ${photo.title}`}
              data-slot-dialog={`photo-${rowIndex * 5 + index}`}
            >
              <span class="garland__swing">
                <span class="garland__pin" aria-hidden="true" />
                <span class="garland__photo">
                  <img src={photo.src} alt="" loading="lazy" decoding="async" />
                </span>
              </span>
            </button>
          ))}
        </div>
      ))
    }
  </div>
</section>

<section class="portfolio-slots video-section" aria-labelledby="video-title">
  <div class="section-heading section-heading--center" data-reveal>
    <h2 id="video-title">Seleccion audiovisual</h2>
  </div>

  <div class="portfolio-grid">
    {
      videos.map((video, index) => (
        <article
          class:list={{
            "portfolio-slot": true,
            "portfolio-slot--video": true,
            "portfolio-slot--large": video.size === "large",
          }}
          data-reveal
          style={`--delay:${index * 120}ms`}
        >
          <button
            class="portfolio-slot__trigger"
            type="button"
            aria-label={`Abrir ${video.title.toLowerCase()}`}
            data-slot-dialog={`video-${index}`}
          >
            <span class="portfolio-slot__frame" aria-hidden="true">
              <span class="portfolio-slot__window" data-timecode="00:00:00:00">
                <img
                  src={`https://i.ytimg.com/vi/${video.youtubeId}/maxresdefault.jpg`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span class="portfolio-slot__mark">▶</span>
              </span>
            </span>
            <span class="portfolio-slot__caption">{video.title}</span>
          </button>
          <div class="portfolio-slot__inline">
            <iframe
              class="portfolio-slot__inline-player"
              title={video.title}
              data-inline-youtube-id={video.youtubeId}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
            <p class="portfolio-slot__caption">{video.title}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

{
  photos.map((photo, index) => (
    <dialog
      class="image-dialog portfolio-slot-dialog"
      data-group="photo"
      id={`photo-${index}`}
      aria-label={photo.title}
    >
      <div class="image-dialog__content">
        <div class="image-dialog__header">
          <p class="popup-swipe-hint">Desliza para cambiar de foto</p>
          <button
            class="image-dialog__close"
            type="button"
            aria-label={`Cerrar ${photo.title}`}
          >
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <div class="item-dialog__stage">
          <button
            class="item-dialog__nav item-dialog__nav--previous"
            type="button"
            data-slot-step="-1"
            aria-label="Trabajo anterior"
          >
            <span aria-hidden="true">‹</span>
          </button>
          <div class="zoom-frame" data-zoom>
            <img src={photo.src} alt={photo.title} />
          </div>
          <button
            class="item-dialog__nav item-dialog__nav--next"
            type="button"
            data-slot-step="1"
            aria-label="Trabajo siguiente"
          >
            <span aria-hidden="true">›</span>
          </button>
        </div>
      </div>
    </dialog>
  ))
}

{
  videos.map((video, index) => (
    <dialog
      class="image-dialog portfolio-slot-dialog"
      data-group="video"
      id={`video-${index}`}
      aria-label={video.title}
    >
      <div class="image-dialog__content">
        <div class="image-dialog__header">
          <p class="popup-swipe-hint">Desliza sobre los lados del video para cambiar</p>
          <button
            class="image-dialog__close"
            type="button"
            aria-label={`Cerrar ${video.title.toLowerCase()}`}
          >
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <div class="item-dialog__stage">
          <button
            class="item-dialog__nav item-dialog__nav--previous"
            type="button"
            data-slot-step="-1"
            aria-label="Video anterior"
          >
            <span aria-hidden="true">‹</span>
          </button>
          <div
            class="portfolio-slot-dialog__preview"
            aria-label={`Previsualizacion de ${video.title.toLowerCase()}`}
          >
            <iframe
              title={video.title}
              data-youtube-id={video.youtubeId}
              allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
          <button
            class="item-dialog__nav item-dialog__nav--next"
            type="button"
            data-slot-step="1"
            aria-label="Video siguiente"
          >
            <span aria-hidden="true">›</span>
          </button>
        </div>
      </div>
    </dialog>
  ))
}

<script>
  import { attachZoom, resetZoom } from "../scripts/zoom";
  import { attachSwipe } from "../scripts/swipe";

  const loadVideo = (dialog: HTMLDialogElement) => {
    const iframe = dialog.querySelector<HTMLIFrameElement>(
      "iframe[data-youtube-id]",
    );
    const videoId = iframe?.dataset.youtubeId;
    if (iframe && videoId) {
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&playsinline=1&rel=0`;
    }
  };

  const stopVideo = (dialog: HTMLDialogElement) => {
    const iframe = dialog.querySelector<HTMLIFrameElement>(
      "iframe[data-youtube-id]",
    );
    iframe?.removeAttribute("src");
  };

  const setupPortfolioSlotDialogs = () => {
    document
      .querySelectorAll<HTMLButtonElement>("[data-slot-dialog]")
      .forEach((trigger) => {
        const dialogId = trigger.dataset.slotDialog;
        const dialog = dialogId
          ? (document.getElementById(dialogId) as HTMLDialogElement | null)
          : null;
        const close = dialog?.querySelector<HTMLButtonElement>(
          ".image-dialog__close",
        );

        if (!dialog || !close || trigger.dataset.dialogReady === "true") return;

        trigger.dataset.dialogReady = "true";
        attachSwipe(dialog, (step) => stepSlot(dialog, step));
        const zoomFrame = dialog.querySelector<HTMLElement>("[data-zoom]");
        if (zoomFrame) {
          attachZoom(zoomFrame, () => dialog.close());
          dialog.addEventListener("close", () => resetZoom(zoomFrame));
        }
        trigger.addEventListener("click", () => {
          loadVideo(dialog);
          dialog.showModal();
        });
        dialog.addEventListener("close", () => stopVideo(dialog));
        close.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
        dialog
          .querySelectorAll<HTMLButtonElement>("[data-slot-step]")
          .forEach((button) => {
            button.addEventListener("click", () =>
              stepSlot(dialog, Number(button.dataset.slotStep)),
            );
          });
      });
  };

  // Cambia de trabajo dentro del mismo grupo (fotos o videos) sin dejar de mostrar el popup.
  const stepSlot = (current: HTMLDialogElement, step: number) => {
    let dialogs = Array.from(
      document.querySelectorAll<HTMLDialogElement>(
        `.portfolio-slot-dialog[data-group="${current.dataset.group}"]`,
      ),
    );
    if (current.dataset.group === "photo" && window.matchMedia("(max-width: 900px)").matches)
      dialogs = dialogs.slice(0, 5);
    const index = dialogs.indexOf(current);
    const next = dialogs[(index + step + dialogs.length) % dialogs.length];
    if (!next || next === current) return;
    current.close();
    loadVideo(next);
    next.showModal();
  };

  // Las fotos del tendedero se "revelan" al entrar en pantalla.
  const setupDevelop = () => {
    const items = document.querySelectorAll<HTMLElement>(
      ".garland__item:not([data-develop])",
    );
    if (!items.length || !("IntersectionObserver" in window)) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-developed");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.25 },
    );
    items.forEach((item) => {
      item.dataset.develop = "true";
      item.classList.add("is-developing");
      observer.observe(item);
    });
  };

  if (!(window as any).__slotKeysReady) {
    (window as any).__slotKeysReady = true;
    document.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      const open = document.querySelector<HTMLDialogElement>(
        ".portfolio-slot-dialog[open]",
      );
      if (open) stepSlot(open, event.key === "ArrowRight" ? 1 : -1);
    });
  }

  // El hilo y las pinzas comparten la misma parabola, calculada en pixeles reales.
  const hangPhotos = () => {
    if (window.matchMedia("(max-width: 900px)").matches) return;
    document.querySelectorAll<HTMLElement>(".garland").forEach((garland) => {
      const width = garland.getBoundingClientRect().width;
      if (!width) return;
      const sag = 44;
      const reach = 2400;
      const slope = (4 * sag) / width;
      const curveY = (x: number) => 4 + 4 * sag * (x / width) * (1 - x / width);
      const path = garland.querySelector(".garland__thread path");
      path?.setAttribute(
        "d",
        `M${-reach} ${4 - slope * reach} L0 4 Q${width / 2} ${4 + 2 * sag} ${width} 4 L${width + reach} ${4 - slope * reach}`,
      );
      const origin = garland.getBoundingClientRect().left;
      const svgTop = garland
        .querySelector(".garland__thread")!
        .getBoundingClientRect().top;
      const items = [
        ...garland.querySelectorAll<HTMLElement>(".garland__item"),
      ];
      items.forEach((item) => {
        const itemBox = item.getBoundingClientRect();
        const x = Math.min(
          Math.max(itemBox.left + itemBox.width / 2 - origin, 0),
          width,
        );
        item.style.setProperty("--drop", `${curveY(x).toFixed(1)}px`);
      });
      // Corrige cualquier desfase real entre el hilo y la parte superior de cada foto.
      // Extremos un poco mas arriba (tocan el hilo) y centrales un poco mas abajo.
      items.forEach((item) => {
        const itemBox = item.getBoundingClientRect();
        const x = Math.min(
          Math.max(itemBox.left + itemBox.width / 2 - origin, 0),
          width,
        );
        const error = itemBox.top - svgTop - curveY(x);
        if (Math.abs(error) > 0.5)
          item.style.setProperty(
            "--drop",
            `${(curveY(x) - error).toFixed(1)}px`,
          );
      });
      const nudge = [-20, 0, 6, 0, -20];
      items.forEach((item, index) => {
        const current = parseFloat(item.style.getPropertyValue("--drop"));
        item.style.setProperty(
          "--drop",
          `${(current + (nudge[index] ?? 0)).toFixed(1)}px`,
        );
      });
    });
  };
  const hangObserver =
    "ResizeObserver" in window ? new ResizeObserver(() => hangPhotos()) : null;
  if (!(window as any).__hangReady) {
    (window as any).__hangReady = true;
    window.addEventListener("resize", hangPhotos);
    window.addEventListener("load", hangPhotos);
    document.fonts?.ready.then(hangPhotos);
  }

  const init = () => {
    setupPortfolioSlotDialogs();
    setupDevelop();
    hangPhotos();
    document
      .querySelectorAll(".garland")
      .forEach((garland) => hangObserver?.observe(garland));
  };
  init();
  document.addEventListener("astro:page-load", init);
</script>
