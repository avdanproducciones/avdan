---
const slots = [
  { type: 'Video destacado', size: 'large' },
  { type: 'Fotografía', size: 'standard' },
  { type: 'Video', size: 'standard' },
  { type: 'Campaña', size: 'standard' },
  { type: 'Proyecto editorial', size: 'standard' },
];
---

<section class="portfolio-slots" aria-labelledby="portfolio-slots-title" data-reveal>
  <div class="section-heading">
    <div>
      <h2 id="portfolio-slots-title">Trabajos seleccionados.</h2>
    </div>
  </div>

  <div class="portfolio-grid">
    {slots.map((slot) => (
      <article class:list={{ 'portfolio-slot': true, 'portfolio-slot--large': slot.size === 'large' }}>
        <button class="portfolio-slot__trigger" type="button" aria-label={`Abrir trabajo de ${slot.type.toLowerCase()}`} data-slot-dialog={`slot-${slot.type.toLowerCase().replaceAll(' ', '-')}`}>
          <span class="portfolio-slot__frame" aria-hidden="true">
          <span class="portfolio-slot__mark" aria-hidden="true">+</span>
          </span>
        </button>
      </article>
    ))}
  </div>
</section>

{slots.map((slot) => (
  <dialog class="image-dialog portfolio-slot-dialog" id={`slot-${slot.type.toLowerCase().replaceAll(' ', '-')}`} aria-labelledby={`slot-title-${slot.type.toLowerCase().replaceAll(' ', '-')}`}>
    <div class="image-dialog__content">
      <div class="image-dialog__header">
        <p id={`slot-title-${slot.type.toLowerCase().replaceAll(' ', '-')}`}>{slot.type}</p>
        <button class="image-dialog__close" type="button" aria-label={`Cerrar trabajo de ${slot.type.toLowerCase()}`}>
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <div class="portfolio-slot-dialog__preview" aria-label={`Previsualización del trabajo de ${slot.type.toLowerCase()}`}>
        <span aria-hidden="true">+</span>
      </div>
    </div>
  </dialog>
))}

<script>
  const setupPortfolioSlotDialogs = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-slot-dialog]').forEach((trigger) => {
      const dialogId = trigger.dataset.slotDialog;
      const dialog = dialogId ? document.getElementById(dialogId) as HTMLDialogElement | null : null;
      const close = dialog?.querySelector<HTMLButtonElement>('.image-dialog__close');

      if (!dialog || !close || trigger.dataset.dialogReady === 'true') return;

      trigger.dataset.dialogReady = 'true';
      trigger.addEventListener('click', () => dialog.showModal());
      close.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  };

  setupPortfolioSlotDialogs();
  document.addEventListener('astro:page-load', setupPortfolioSlotDialogs);
</script>
