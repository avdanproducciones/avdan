---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto">
  <section class="page interior-page contact-page interior-page--contact">
    <div class="interior-hero">
      <div class="hero-copy" data-reveal>
        <h1><span class="idea-highlight">Tu idea</span> comienza aqui.</h1>
        <p class="intro">
          Cuentanos que quieres comunicar. Estamos listos para escucharte y darle
          vida a tu proyecto.
        </p>
        <a class="editorial-link" href="mailto:avdan.producciones@gmail.com"
          >Escribir un correo <span aria-hidden="true">↗</span></a
        >
      </div>
      <a class="scroll-cue" href="#redes-sociales" aria-label="Bajar a las redes sociales">
        <span aria-hidden="true"></span>
      </a>
    </div>
    <div class="social-previews" id="redes-sociales">
      <a
        class="social-card social-card--instagram"
        href="https://www.instagram.com/avdan.prod/"
        target="_blank"
        rel="noopener noreferrer"
        data-reveal="left"
        aria-label="Ver el perfil de Instagram de AVDAN"
      >
        <div class="social-card__head">
          <span class="social-card__avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24"
              ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle
                cx="12"
                cy="12"
                r="4.2"></circle><circle
                cx="17.4"
                cy="6.7"
                r="1"
                class="social-card__avatar-fill"></circle></svg
            >
          </span>
          <span><strong>@avdan</strong><small>Instagram</small></span>
        </div>
        <div class="social-card__grid" aria-hidden="true">
          <span
            ><img
              src="/media/projects/seleccion-01.webp"
              alt=""
              loading="lazy"
              decoding="async"
            /></span
          >
          <span
            ><img
              src="/media/projects/seleccion-07.webp"
              alt=""
              loading="lazy"
              decoding="async"
            /></span
          >
          <span
            ><img
              src="/media/projects/seleccion-10.webp"
              alt=""
              loading="lazy"
              decoding="async"
            /></span
          >
          <span
            ><img
              src="/media/projects/seleccion-06.webp"
              alt=""
              loading="lazy"
              decoding="async"
            /></span
          >
          <span
            ><img
              src="/media/projects/seleccion-03.webp"
              alt=""
              loading="lazy"
              decoding="async"
            /></span
          >
          <span
            ><img
              src="/media/projects/seleccion-05.webp"
              alt=""
              loading="lazy"
              decoding="async"
            /></span
          >
        </div>
        <span class="social-card__cta"
          >Ver perfil <span aria-hidden="true">↗</span></span
        >
      </a>
      <a
        class="social-card social-card--youtube"
        href="https://www.youtube.com/channel/UCySStgJVu23f-DTDuiiPX9Q"
        target="_blank"
        rel="noopener noreferrer"
        data-reveal="right"
        style="--delay:120ms"
        aria-label="Ver el canal de YouTube de AVDAN"
      >
        <div class="social-card__head">
          <span class="social-card__avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24"
              ><path
                d="M21 8.2a2.8 2.8 0 0 0-2-2C17.2 5.7 12 5.7 12 5.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.5 12 29 29 0 0 0 3 15.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.8 29 29 0 0 0-.5-3.8Z"
              ></path><path
                d="m10 9 5 3-5 3V9Z"
                class="social-card__avatar-fill"></path></svg
            >
          </span>
          <span><strong>AVDAN</strong><small>YouTube</small></span>
        </div>
        <div class="social-card__video" aria-hidden="true">
          <img
            src="https://i.ytimg.com/vi/hcbyyc0O8Ng/maxresdefault.jpg"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span class="social-card__play"></span>
        </div>
        <span class="social-card__video-title">Memorias del Mar</span>
        <span class="social-card__cta"
          >Ver canal <span aria-hidden="true">↗</span></span
        >
      </a>
    </div>
  </section>
</Layout>
