---
import '../styles/views.css';
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import { categoryThumbnail, categoryThumbnailSet, thumbnail, thumbnailSet } from '../data/images';
import videoPoster from '../../public/media/video/hcbyyc0O8Ng.jpg';

const filmstripPhotos = ['eventos-08', 'matrimonios-14', 'sesiones-01'].map(
  (name) => `/media/projects/${name}.webp`,
);

const instagramPhotos = ['01', '07', '10', '06', '03', '05'].map(
  (number) => `/media/projects/seleccion-${number}.webp`,
);
---

<Layout title="Contacto">
  <section class="page interior-page contact-page interior-page--contact">
    <div class="interior-hero">
      <div class="hero-copy contact-hero">
        <div class="contact-hero__heading">
          <h1 class="contact-title">
            <span class="contact-title__block idea-highlight">Tu idea</span>
            <span class="contact-title__block">comienza</span>
            <span class="contact-title__block">aqui</span>
          </h1>
          <div class="contact-filmstrip" aria-hidden="true">
            {filmstripPhotos.map((src) => (
              <img
                src={categoryThumbnail(src, 360)}
                srcset={categoryThumbnailSet(src)}
                sizes="(max-width: 500px) 30vw, (max-width: 900px) 190px, 210px"
                alt=""
                decoding="async"
              />
            ))}
          </div>
        </div>
        <p class="intro">
          Cuéntanos qué tienes en mente. En <span class="idea-highlight">AVDAN</span> transformamos ideas en fotografías y producciones audiovisuales que conectan, emocionan y cuentan historias.
        </p>
        <a class="editorial-link contact-hero__link" href="mailto:avdan.producciones@gmail.com"
          >Escribenos por correo <span aria-hidden="true">↗</span></a
        >
      </div>
      <a class="scroll-cue" href="#redes-sociales" aria-label="Bajar a las redes sociales">
        <span aria-hidden="true"></span>
      </a>
    </div>
    <div class="social-previews" id="redes-sociales">
      <a
        class="social-card social-card--instagram"
        href="https://www.instagram.com/avdan.prod/"
        target="_blank"
        rel="noopener noreferrer"
        data-reveal="left"
        aria-label="Ver el perfil de Instagram de AVDAN"
      >
        <div class="social-card__head">
          <span class="social-card__avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24"
              ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle
                cx="12"
                cy="12"
                r="4.2"></circle><circle
                cx="17.4"
                cy="6.7"
                r="1"
                class="social-card__avatar-fill"></circle></svg
            >
          </span>
          <span><strong>@avdan.prod</strong><small>Instagram</small></span>
        </div>
        <div class="social-card__grid" aria-hidden="true">
          {instagramPhotos.map((src) => (
            <span>
              <img
                src={thumbnail(src, 360)}
                srcset={thumbnailSet(src)}
                sizes="(max-width: 900px) calc((100vw - 64px) / 3), 16vw"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
          ))}
        </div>
        <span class="social-card__cta"
          >Ver perfil <span aria-hidden="true">↗</span></span
        >
      </a>
      <a
        class="social-card social-card--youtube"
        href="https://www.youtube.com/channel/UCySStgJVu23f-DTDuiiPX9Q"
        target="_blank"
        rel="noopener noreferrer"
        data-reveal="right"
        style="--delay:120ms"
        aria-label="Ver el canal de YouTube de AVDAN"
      >
        <div class="social-card__head">
          <span class="social-card__avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24"
              ><path
                d="M21 8.2a2.8 2.8 0 0 0-2-2C17.2 5.7 12 5.7 12 5.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.5 12 29 29 0 0 0 3 15.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.8 29 29 0 0 0-.5-3.8Z"
              ></path><path
                d="m10 9 5 3-5 3V9Z"
                class="social-card__avatar-fill"></path></svg
            >
          </span>
          <span><strong>AVDAN</strong><small>YouTube</small></span>
        </div>
        <div class="social-card__video" aria-hidden="true">
          <Image
            src={videoPoster}
            widths={[400, 640, 960]}
            sizes="(max-width: 900px) calc(100vw - 56px), 50vw"
            format="avif"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span class="social-card__play"></span>
        </div>
        <span class="social-card__video-title">Memorias del Mar</span>
        <span class="social-card__cta"
          >Ver canal <span aria-hidden="true">↗</span></span
        >
      </a>
    </div>
  </section>
</Layout>
