---
import Layout from '../layouts/Layout.astro';
import ProjectCarousel from '../components/ProjectCarousel';
import PortfolioSlots from '../components/PortfolioSlots.astro';
import { projects } from '../data/projects';
---
<Layout title="Portafolio">
  <section class="hero-video" aria-label="Video introductorio">
    <div class="hero-video__frame">
      <video
        class="hero-video__player"
        src="/media/video/promo-festival-gastronomico.mp4"
        controls
        autoplay
        playsinline
        preload="auto"
      >
        Tu navegador no puede reproducir este video.
      </video>
      <button class="hero-video__sound" type="button" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" /><path d="m17 9 4 6M21 9l-4 6" /></svg>
        Toca para ver con sonido
      </button>
    </div>
  </section>
  <section class="page home-page">
    <a class="scroll-cue" href="#seleccion" aria-label="Bajar a la seleccion de trabajos">
      <span aria-hidden="true"></span>
    </a>
    <PortfolioSlots />
    <section class="work-section" id="categorias">
      <div class="section-heading section-heading--center" data-reveal>
        <h2>Categorias</h2>
      </div>
      <div data-reveal style="--delay:120ms">
        <ProjectCarousel projects={projects} client:load />
      </div>
    </section>
  </section>
</Layout>

<script>
  // Los navegadores bloquean el audio automatico en la primera visita directa. Se intenta con sonido
  // y, si lo bloquean, arranca en silencio y se activa el sonido con la primera interaccion del usuario.
  let autoMuted = false;

  const getVideo = () => document.querySelector<HTMLVideoElement>('.hero-video__player');
  const getHint = () => document.querySelector<HTMLButtonElement>('.hero-video__sound');

  const enableSound = () => {
    const video = getVideo();
    if (!video || !autoMuted) return;
    autoMuted = false;
    video.currentTime = 0;
    video.muted = false;
    video.play().catch(() => {});
    const hint = getHint();
    if (hint) hint.hidden = true;
  };

  const playIntro = async () => {
    const video = getVideo();
    const hint = getHint();
    if (!video) return;
    autoMuted = false;
    if (hint) hint.hidden = true;
    video.currentTime = 0;
    video.muted = false;
    try {
      await video.play();
    } catch {
      autoMuted = true;
      video.muted = true;
      video.play().catch(() => {});
      if (hint) hint.hidden = false;
    }
  };

  const unlock = (event: Event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest?.('.hero-video__player')) {
      autoMuted = false;
      return;
    }
    enableSound();
  };

  ['pointerdown', 'keydown', 'touchend'].forEach((name) => document.addEventListener(name, unlock, { capture: true }));
  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('.hero-video__sound')) enableSound();
  });
  document.addEventListener('astro:page-load', () => {
    if (getVideo()) playIntro();
  });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) playIntro();
  });
</script>
