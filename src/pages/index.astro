---
import Layout from '../layouts/Layout.astro';
import ProjectCarousel from '../components/ProjectCarousel';
import PortfolioSlots from '../components/PortfolioSlots.astro';
import { projects } from '../data/projects';
---
<Layout title="Portafolio">
  <section class="page home-page">
    <div class="hero-feature" data-reveal>
      <div class="hero-copy">
        <h1>Ideas que se mueven.</h1>
        <p class="intro">Creamos imágenes, historias y experiencias que conectan con las personas.</p>
      </div>
      <figure class="hero-image">
        <button class="hero-image__trigger" type="button" aria-label="Expandir imagen de un matrimonio en una iglesia">
          <img src="/media/projects/matrimonio-iglesia-79.webp" alt="Momento de un matrimonio en una iglesia" loading="eager" fetchpriority="high" />
        </button>
      </figure>
    </div>
    <a class="scroll-cue" href="#trabajos" aria-label="Bajar a trabajos destacados">
      <span aria-hidden="true"></span>
    </a>
    <section class="work-section" id="trabajos" data-reveal>
      <div class="section-heading">
        <h2>Categorías</h2>
      </div>
      <ProjectCarousel projects={projects} client:load />
    </section>
    <PortfolioSlots />
  </section>
</Layout>

<dialog id="hero-image-dialog" class="image-dialog" aria-labelledby="image-dialog-title">
  <div class="image-dialog__content">
    <div class="image-dialog__header">
      <p id="image-dialog-title">Matrimonio en Iglesia <span aria-hidden="true"></span></p>
      <button class="image-dialog__close" type="button" aria-label="Cerrar imagen ampliada">
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="zoom-frame" data-zoom>
      <img src="/media/projects/matrimonio-iglesia-79.webp" alt="Momento de un matrimonio en una iglesia, ampliado" />
    </div>
  </div>
</dialog>

<script>
  import { attachZoom, resetZoom } from '../scripts/zoom';

  const setupHeroImageDialog = () => {
    const imageTrigger = document.querySelector<HTMLButtonElement>('.hero-image__trigger');
    const imageDialog = document.querySelector<HTMLDialogElement>('#hero-image-dialog');
    const imageDialogClose = imageDialog?.querySelector<HTMLButtonElement>('.image-dialog__close');
    const zoomFrame = imageDialog?.querySelector<HTMLElement>('[data-zoom]');

    if (!imageTrigger || !imageDialog || !imageDialogClose || imageTrigger.dataset.dialogReady === 'true') return;

    imageTrigger.dataset.dialogReady = 'true';
    if (zoomFrame) {
      attachZoom(zoomFrame, () => imageDialog.close());
      imageDialog.addEventListener('close', () => resetZoom(zoomFrame));
    }
    imageTrigger.addEventListener('click', () => imageDialog.showModal());
    imageDialogClose.addEventListener('click', () => imageDialog.close());
    imageDialog.addEventListener('click', (event) => {
      if (event.target === imageDialog) imageDialog.close();
    });
  };

  setupHeroImageDialog();
  document.addEventListener('astro:page-load', setupHeroImageDialog);
</script>
