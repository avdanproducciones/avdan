---
import Layout from "../layouts/Layout.astro";

const services = [
  {
    title: "EVENTOS",
    headline: [
      { text: "Más que registrar un evento, " },
      { text: "contamos", highlight: true },
      { text: " lo que sucede en él." },
    ],
    offerings: [
      "COBERTURA AUDIOVISUAL",
      "REGISTRO FOTOGRÁFICO Y VIDEO",
      "RESÚMENES Y CÁPSULAS",
    ],
  },
  {
    title: "MATRIMONIOS",
    headline: [
      { text: "Historias", highlight: true },
      { text: " que merecen ser recordadas tal como se vivieron." },
    ],
    offerings: [
      "FOTOGRAFÍA DE MATRIMONIO",
      "VIDEO CINEMATOGRÁFICO",
      "REGISTRO DE CEREMONIA Y CELEBRACIÓN",
    ],
  },
  {
    title: "PUBLICIDAD",
    headline: [
      { text: "Tu negocio", highlight: true },
      { text: " tiene algo que ofrecer. Hagamos que se note." },
    ],
    offerings: [
      "CONCEPTO CREATIVO",
      "VIDEOS PUBLICITARIOS",
      "CONTENIDO PARA REDES SOCIALES",
    ],
  },
  {
    title: "FOTOGRAFIA",
    headline: [
      { text: "Cada imagen " },
      { text: "comunica", highlight: true },
      { text: " algo. Hagamos que " },
      { text: "comunique", highlight: true },
      { text: " lo que buscas." },
    ],
    offerings: [
      "FOTOGRAFÍA DE PRODUCTOS",
      "RETRATOS Y SESIONES",
      "FOTOGRAFÍA COMERCIAL",
    ],
  },
  {
    title: "DRONE Y FOTOGRAFIA AEREA",
    headline: [
      { text: "Hay " },
      { text: "perspectivas", highlight: true },
      { text: " que solo se descubren desde el aire." },
    ],
    offerings: ["FOTOGRAFÍA AÉREA", "VIDEO CON DRONE", "PLANOS Y TOMAS AÉREAS"],
  },
  {
    title: "EDICION Y POSTPRODUCCION",
    headline: [
      { text: "El material cobra " },
      { text: "sentido", highlight: true },
      { text: " cuando cada pieza encuentra su lugar." },
    ],
    offerings: [
      "MONTAJE AUDIOVISUAL",
      "CORRECCIÓN Y GRADACIÓN DE COLOR",
      "EDICIÓN Y DISEÑO SONORO",
    ],
  },
  {
    title: "DOCUMENTALES",
    headline: [
      { text: "Las " },
      { text: "historias reales", highlight: true },
      { text: " merecen ser " },
      { text: "contadas", highlight: true },
      { text: " con otra mirada." },
    ],
    offerings: [
      "INVESTIGACIÓN Y GUIÓN",
      "ENTREVISTAS Y TESTIMONIOS",
      "NARRATIVA DOCUMENTAL",
    ],
  },
];

const editingImages = [
  {
    src: "/media/servicios/edicion-1.webp",
    alt: "Línea de tiempo y panel de color en Adobe Premiere Pro",
    title: "Montaje y color en Premiere Pro",
    caption: "Montaje y color",
  },
  {
    src: "/media/servicios/edicion-2.webp",
    alt: "Árbol de nodos y curvas de color en DaVinci Resolve",
    title: "Gradación de color con nodos en DaVinci Resolve",
    caption: "Gradación con nodos",
  },
  {
    src: "/media/servicios/edicion-3.webp",
    alt: "Corrección primaria de color sobre un retrato en DaVinci Resolve",
    title: "Corrección primaria en DaVinci Resolve",
    caption: "Corrección primaria",
  },
];
---

<Layout title="Servicios">
  <section class="page interior-page interior-page--services">
    <div class="interior-hero">
      <div class="services-hero">
        <div class="hero-copy" data-reveal>
          <h1>De <span class="idea-highlight">tu idea</span> a la imagen</h1>
          <p class="intro">
            Creamos fotografía y contenido audiovisual que comunica, emociona y
            destaca, desde la planificación hasta la entrega final.
          </p>
          <a class="editorial-link" href="/contacto/">
            <span>Cuentanos <span class="idea-highlight">tu idea</span></span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <button
          class="edit-showcase__item services-hero__compare"
          data-reveal="right"
          style="--delay:200ms"
          type="button"
          data-lightbox="/media/servicios/edicion-comparacion.webp"
          data-lightbox-title="Comparación de color: material original y exportado"
        >
          <img
            src="/media/servicios/edicion-comparacion.webp"
            alt="Comparación de color entre el material original y el exportado"
            loading="lazy"
            decoding="async"
          />
          <span>Corrección de color · antes y después</span>
        </button>
      </div>
      <a
        class="scroll-cue"
        href="#tech-stack-title"
        aria-label="Bajar al TechStack"><span aria-hidden="true"></span></a
      >
    </div>
    <section class="service-tech-stack" aria-labelledby="tech-stack-title">
      <div class="service-tech-stack__heading">
        <h2 id="tech-stack-title">TechStack</h2>
        <div
          class="service-tech-stack__tools"
          aria-label="Tecnologías utilizadas"
        >
          <div class="service-tech-stack__tool">
            <svg
              class="service-tech-stack__photoshop"
              viewBox="0 0 64 64"
              role="img"
              aria-labelledby="photoshop-logo-title"
            >
              <title id="photoshop-logo-title">Adobe Photoshop</title>
              <rect x="3" y="3" width="58" height="58" rx="8"></rect>
              <text x="32" y="41" text-anchor="middle">Ps</text>
            </svg>
            <span>Photoshop</span>
          </div>
          <div class="service-tech-stack__tool">
            <svg
              class="service-tech-stack__premiere"
              viewBox="0 0 64 64"
              role="img"
              aria-labelledby="premiere-logo-title"
            >
              <title id="premiere-logo-title">Adobe Premiere Pro</title>
              <rect x="3" y="3" width="58" height="58" rx="8"></rect>
              <path
                d="M18 45V19h10c7 0 11 4 11 10s-4 10-11 10h-4v6h-6Zm6-12h4c3 0 5-1 5-4s-2-4-5-4h-4v8Zm17 12V28h6v3c1-2 3-4 6-4v6c-4 0-6 2-6 5v7h-6Z"
              ></path>
            </svg>
            <span>Premiere Pro</span>
          </div>
          <div class="service-tech-stack__tool">
            <svg
              class="service-tech-stack__lightroom"
              viewBox="0 0 64 64"
              role="img"
              aria-labelledby="lightroom-logo-title"
            >
              <title id="lightroom-logo-title">Adobe Lightroom</title>
              <rect x="3" y="3" width="58" height="58" rx="8"></rect>
              <text x="32" y="41" text-anchor="middle">Lr</text>
            </svg>
            <span>Lightroom</span>
          </div>
          <div class="service-tech-stack__tool">
            <svg
              class="service-tech-stack__after-effects"
              viewBox="0 0 64 64"
              role="img"
              aria-labelledby="after-effects-logo-title"
            >
              <title id="after-effects-logo-title">Adobe After Effects</title>
              <rect x="3" y="3" width="58" height="58" rx="8"></rect>
              <text x="32" y="41" text-anchor="middle">Ae</text>
            </svg>
            <span>After Effects</span>
          </div>
          <div class="service-tech-stack__tool">
            <img
              class="service-tech-stack__resolve"
              src="/media/servicios/davinci-resolve-logo.png"
              alt=""
              width="52"
              height="52"
              loading="lazy"
              decoding="async"
            />
            <span>DaVinci Resolve</span>
          </div>
        </div>
      </div>
      <div class="service-tech-stack__gallery">
        <button
          class="edit-showcase__item service-tech-stack__image service-tech-stack__compare"
          data-reveal
          type="button"
          data-lightbox="/media/servicios/edicion-comparacion.webp"
          data-lightbox-title="Comparación de color: material original y exportado"
        >
          <img
            src="/media/servicios/edicion-comparacion.webp"
            alt="Comparación de color entre el material original y el exportado"
            loading="lazy"
            decoding="async"
          />
          <span>Corrección de color · antes y después</span>
        </button>
        {
          editingImages.map((image) => (
            <button
              class="edit-showcase__item service-tech-stack__image"
              data-reveal
              type="button"
              data-lightbox={image.src}
              data-lightbox-title={image.title}
            >
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
              />
              <span>{image.caption}</span>
            </button>
          ))
        }
      </div>
    </section>
    <div class="service-path" id="servicios-lista">
      <h2 class="service-path__heading">SERVICIOS</h2>
      {
        services.map((service) => (
          <article class="service-step" data-reveal>
            <div class="service-step__title" data-from="left">
              <h2>{service.title}</h2>
            </div>
            <div class="service-step__body" data-from="right">
              <h3>
                {service.headline.map((part) =>
                  part.highlight ? (
                    <span class="idea-highlight">{part.text}</span>
                  ) : (
                    part.text
                  ),
                )}
              </h3>
              <ul>
                {service.offerings.map((offering) => (
                  <li>{offering}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
    <a class="editorial-link service-path__cta" href="/contacto/" data-reveal>
      <span>Cuentanos <span class="idea-highlight">tu idea</span></span>
      <span aria-hidden="true">↗</span>
    </a>
  </section>
</Layout>

<style>
  #tech-stack-title {
    scroll-margin-top: var(--header-h);
  }

  .service-tech-stack__gallery {
    margin-top: clamp(24px, 3vw, 40px);
  }

  .service-tech-stack__compare {
    display: none;
  }

  @media (max-width: 900px) {
    .services-hero__compare {
      display: none;
    }

    .service-tech-stack__compare {
      display: grid;
    }
  }
</style>
