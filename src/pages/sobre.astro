---
import '../styles/views.css';
import Layout from '../layouts/Layout.astro';

---
<Layout title="Acerca de">
  <section class="page interior-page interior-page--about about-page">
    <div class="interior-hero">
      <div class="hero-copy about-hero">
        <div class="about-hero__heading">
          <h1 class="about-title">
            <span class="about-title__block"><span class="idea-highlight">Tu ide<span data-bulb-impact="first">a</span></span><span class="about-title__baseline" aria-hidden="true"></span></span>
            <span class="about-title__block">merece</span>
            <span class="about-title__block">una <span class="idea-highlight">gran</span></span>
            <span class="about-title__block"><span class="about-title__last-word">ejecuci<span data-bulb-impact="second">o</span><span data-bulb-impact="last">n</span><span class="about-title__baseline" aria-hidden="true"></span><span class="bulb about-title__bulb" aria-hidden="true"></span></span></span>
          </h1>
          <span class="about-hero__logo-position"><img class="about-hero__logo" src="/logo-avdan.svg" width="320" height="226" alt="" aria-hidden="true" /></span>
        </div>
        <p class="intro about-hero__intro">Descubre quiénes somos</p>
      </div>
      <a class="scroll-cue" href="#acerca-historia" aria-label="Bajar a la historia de AVDAN">
        <span aria-hidden="true"></span>
      </a>
    </div>
    <div class="about-story" id="acerca-historia">
      <div class="about-story__copy">
        <p class="about-story__lead" data-reveal>En <span class="idea-highlight">AVDAN</span> creemos que cada historia merece una mirada única. Combinamos creatividad, fotografía y producción audiovisual para transformar tus ideas en imágenes que dejan huella.</p>
        <p data-reveal>Por eso, nuestro trabajo comienza escuchando <span class="idea-highlight">tus ideas</span>, comprendiendo <span class="idea-highlight">tus objetivos</span> y encontrando la mejor manera de llevarlos a la realidad a través de la fotografía y la producción audiovisual.</p>
        <p data-reveal>Nos involucramos en cada etapa del proceso, desde la planificación hasta la entrega final, cuidando los detalles y buscando siempre un resultado que responda a tus <span class="idea-highlight">expectativas</span>. Trabajamos con compromiso, creatividad y profesionalismo, adaptándonos a las <span class="idea-highlight">necesidades</span> de cada cliente para crear contenido visual que comunique, emocione y destaque.</p>
      </div>
    </div>
  </section>

  <section class="page about-closing">
    <div class="about-closing__content" data-reveal>
      <p><span class="idea-highlight">Tu idea</span> es el comienzo. En <span class="idea-highlight">AVDAN</span>, nos encargamos de darle vida.</p>
      <a class="editorial-link" href="/contacto/"><span>Hablemos de <span class="idea-highlight">tu idea</span></span> <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>

<script>
  let activeTitle: HTMLElement | undefined;

  const setupAboutBulb = () => {
    const title = document.querySelector<HTMLElement>('.about-title');
    if (!title || title === activeTitle) return;
    const firstBlock = title.querySelector<HTMLElement>('.about-title__block');
    const word = title.querySelector<HTMLElement>('.about-title__last-word');
    const bulb = title.querySelector<HTMLElement>('.about-title__bulb');
    const hero = title.closest<HTMLElement>('.about-hero');
    const subtitle = hero?.querySelector<HTMLElement>('.about-hero__intro');
    const logo = hero?.querySelector<HTMLElement>('.about-hero__logo');
    const firstLetter = title.querySelector<HTMLElement>('[data-bulb-impact="first"]');
    const secondLetter = title.querySelector<HTMLElement>('[data-bulb-impact="second"]');
    const lastLetter = title.querySelector<HTMLElement>('[data-bulb-impact="last"]');
    const baselines = title.querySelectorAll<HTMLElement>('.about-title__baseline');
    if (!firstBlock || !word || !bulb || !subtitle || !logo || !firstLetter || !secondLetter || !lastLetter || baselines.length !== 2) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const flightDuration = 2000;
    const lightPause = 500;
    const flickerDuration = 350;
    const firstImpactOffset = .325;
    const impactAfterTitle = 40;
    const canvas = document.createElement('canvas').getContext('2d');
    if (!canvas) {
      console.warn('No se pudo medir el texto para posicionar el foco.');
      return;
    }
    activeTitle = title;
    let active = true;
    let flight: Animation | undefined;
    const bulbSound = new Audio('/media/efecto-de-sonido-foco-luz-rota.mp3');
    bulbSound.preload = 'auto';
    const revealAnimations: Animation[] = [];

    const playLandingSound = () => {
      if (!active || !title.isConnected || reducedMotion.matches) return;
      // Omite el silencio inicial para que el sonido coincida con el aterrizaje.
      bulbSound.currentTime = .128;
      bulbSound.play().catch((error: unknown) => {
        if (error instanceof DOMException && error.name === 'NotAllowedError') {
          console.info('El navegador bloqueó la reproducción automática del sonido del foco.');
        } else {
          console.warn('No se pudo reproducir el sonido del foco:', error);
        }
      });
    };

    const positionBulb = () => {
      // Measure resting positions even while the title blocks are still falling.
      const restingRect = (element: HTMLElement) => {
        const rect = element.getBoundingClientRect();
        const block = element.closest<HTMLElement>('.about-title__block');
        const transform = block ? getComputedStyle(block).transform : 'none';
        const offsetY = transform === 'none' ? 0 : new DOMMatrixReadOnly(transform).m42;
        return { top: rect.top - offsetY, left: rect.left, right: rect.right, width: rect.width };
      };
      const wordRect = restingRect(word);
      const bulbWidth = bulb.offsetWidth;
      const bulbHeight = bulb.offsetHeight;
      const baseline = restingRect(baselines[1]).top;
      const style = getComputedStyle(title);
      const fontSize = parseFloat(style.fontSize);
      const firstRect = restingRect(firstLetter);
      const secondRect = restingRect(secondLetter);
      const lastRect = restingRect(lastLetter);
      const originX = wordRect.right + fontSize * .08;
      const originY = baseline - bulbHeight;

      // Ajusta el desplazamiento del contacto y la altura de los rebotes si cambia el dibujo o la tipografía.
      canvas.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      const firstGlyphTop = canvas.measureText(firstLetter.textContent ?? '').actualBoundingBoxAscent;
      const secondGlyphTop = canvas.measureText(secondLetter.textContent ?? '').actualBoundingBoxAscent;
      const firstX = firstRect.left + firstRect.width / 2 - bulbWidth / 2 - originX;
      const secondX = (secondRect.right + lastRect.left) / 2 - bulbWidth / 2 - originX;
      const firstY = restingRect(baselines[0]).top - firstGlyphTop - bulbHeight - originY;
      const secondY = baseline - secondGlyphTop - bulbHeight - originY;
      title.style.setProperty('--bulb-baseline', `${baseline - wordRect.top}px`);

      const frame = (x: number, y: number, angle: number, offset: number): Keyframe => ({
        offset,
        opacity: 1,
        transform: `translate(${x}px, ${y}px) rotate(${angle}deg)`,
      });
      const frames: Keyframe[] = [
        { ...frame(firstX, -originY - bulbHeight - 10, 0, 0), easing: 'ease-in' },
        frame(firstX, firstY, 0, firstImpactOffset),
      ];
      // Cada rebote interpola X linealmente y Y sobre una parábola.
      for (let i = 1; i <= 16; i++) {
        const t = i / 16;
        frames.push(frame(
          firstX + (secondX - firstX) * t,
          firstY + (secondY - firstY) * t - fontSize * 2 * 4 * t * (1 - t),
          360 * t,
          .325 + .45 * t,
        ));
      }
      for (let i = 1; i <= 16; i++) {
        const t = i / 16;
        frames.push(frame(
          secondX * (1 - t),
          secondY * (1 - t) - fontSize * .45 * 4 * t * (1 - t),
          360 + 360 * t,
          .775 + .225 * t,
        ));
      }
      if (flight?.effect instanceof KeyframeEffect) flight.effect.setKeyframes(frames);
      return { frames };
    };

    const resizeObserver = new ResizeObserver(positionBulb);
    resizeObserver.observe(title);
    const handleMotionChange = () => {
      bulbSound.pause();
      flight?.cancel();
      flight = undefined;
      revealAnimations.forEach((animation) => animation.cancel());
      [subtitle, logo].forEach((element) => { element.style.animation = 'none'; });
      positionBulb();
      bulb.classList.remove('is-animating');
      bulb.classList.add('is-settled');
    };
    reducedMotion.addEventListener('change', handleMotionChange);

    const start = (titleAnimation?: Animation) => {
      if (!active || !title.isConnected || reducedMotion.matches || bulb.classList.contains('is-settled')) return;
      const { frames } = positionBulb();
      flight = bulb.animate(frames, { duration: flightDuration, fill: 'both' });
      let elapsed = 0;
      const now = document.timeline.currentTime;
      if (titleAnimation?.effect && typeof titleAnimation.startTime === 'number' && typeof now === 'number') {
        const titleDuration = titleAnimation.effect.getComputedTiming().endTime;
        if (typeof titleDuration === 'number') {
          const titleEnd = titleAnimation.startTime + titleDuration;
          // El primer impacto coincide con la llegada de «Tu idea».
          const flightStart = titleEnd + impactAfterTitle - flightDuration * firstImpactOffset;
          flight.startTime = Math.max(now, flightStart);
          elapsed = now - flight.startTime;
        }
      }
      bulb.style.setProperty('--bulb-light-delay', `${flightDuration + lightPause - elapsed}ms`);
      bulb.style.setProperty('--bulb-light-duration', `${flickerDuration}ms`);
      bulb.classList.add('is-animating');
      flight.finished.then(playLandingSound, () => {});
      const flightStartTime = flight.startTime;
      [subtitle, logo].forEach((element) => {
        element.style.animation = 'none';
        const animation = element.animate(
          [{ opacity: 0, transform: 'translateY(18px)' }, { opacity: 1, transform: 'none' }],
          { duration: 700, delay: flightDuration + lightPause + flickerDuration, easing: 'ease', fill: 'both' },
        );
        if (typeof flightStartTime === 'number') animation.startTime = flightStartTime;
        revealAnimations.push(animation);
      });
    };

    const firstAnimation = firstBlock.getAnimations().find((animation) =>
      animation instanceof CSSAnimation && animation.animationName === 'about-title-drop',
    );
    if (reducedMotion.matches) {
      handleMotionChange();
    } else if (firstAnimation) {
      firstAnimation.ready.then(start, () => start());
    } else {
      start();
    }
    document.fonts.ready.then(() => {
      if (active) positionBulb();
    });

    document.addEventListener('astro:before-swap', () => {
      active = false;
      activeTitle = undefined;
      bulbSound.pause();
      flight?.cancel();
      revealAnimations.forEach((animation) => animation.cancel());
      resizeObserver.disconnect();
      reducedMotion.removeEventListener('change', handleMotionChange);
    }, { once: true });
  };

  document.addEventListener('astro:after-swap', setupAboutBulb);
  document.addEventListener('astro:page-load', setupAboutBulb);
  setupAboutBulb();
</script>
