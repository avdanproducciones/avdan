---
import Layout from '../layouts/Layout.astro';

const tags = ['Video', 'Fotografia', 'Campanas', 'Matrimonios', 'Editorial'];
const tags2 = ['Direccion creativa', 'Produccion', 'Postproduccion', 'Color', 'Sonido'];
const principles = [
  { title: 'Mirada', text: 'Buscamos el angulo que nadie esperaba y lo sostenemos hasta que dice algo.' },
  { title: 'Ritmo', text: 'Cada pieza respira a su propio tempo: cortes, pausas y movimiento con intencion.' },
  { title: 'Honestidad', text: 'Contamos lo que ocurre, sin adornos que le quiten verdad a la imagen.' },
];
const process = [
  { title: 'Escuchar', text: 'Entendemos tu historia antes de encender la camara.' },
  { title: 'Imaginar', text: 'Convertimos la idea en una mirada y un plan.' },
  { title: 'Filmar', text: 'Rodamos con intencion, luz y movimiento.' },
  { title: 'Entregar', text: 'Montaje, color y sonido hasta el ultimo detalle.' },
];
const team = [
  { name: 'Nombre Apellido', role: 'Direccion creativa' },
  { name: 'Nombre Apellido', role: 'Direccion de fotografia' },
  { name: 'Nombre Apellido', role: 'Montaje y postproduccion' },
];
---
<Layout title="Sobre">
  <section class="page interior-page interior-page--about about-page">
    <div class="hero-copy" data-reveal>
      <h1>Mirar distinto.</h1>
      <p class="intro">AVDAN explora nuevas formas de contar historias a traves de la imagen y el movimiento.</p>
    </div>
  </section>

  <section class="about-process">
    <div class="about-process__head" data-reveal>
      <h2>Como trabajamos.</h2>
      <p class="about-process__rec"><span aria-hidden="true"></span>En camara</p>
    </div>
    <div class="camera">
      <div class="camera__strip">
        <ol class="camera__frames">
          {process.map((step) => (
            <li class="camera__frame" data-reveal>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <div class="camera__viewfinder" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...tags, ...tags, ...tags, ...tags].map((word) => <span>{word}</span>)}
    </div>
    <div class="marquee__track marquee__track--reverse">
      {[...tags2, ...tags2, ...tags2, ...tags2].map((word) => <span>{word}</span>)}
    </div>
  </div>

  <section class="page about-principles">
    <h2 data-reveal>Lo que nos mueve.</h2>
    <div class="about-principles__row">
      {principles.map((item, index) => (
        <article class="principle" data-reveal style={`--delay:${index * 90}ms`}>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="about-process about-team">
    <div class="about-process__head" data-reveal>
      <h2>Las personas detras.</h2>
      <p class="about-process__rec"><span aria-hidden="true"></span>En escena</p>
    </div>
    <div class="camera">
      <div class="camera__strip">
        <div class="about-team__row">
          {team.map((member, index) => (
            <figure class="member" data-reveal style={`--delay:${index * 90}ms`}>
              <div class="member__portrait" data-lightbox="" data-lightbox-title={member.name} role="button" tabindex="0" aria-label={`Ver ${member.name}, ${member.role}`}><span aria-hidden="true">+</span></div>
              <figcaption><strong>{member.name}</strong><span>{member.role}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
    <a class="editorial-link about-team__cta" href="/contacto/" data-reveal>Conversemos <span aria-hidden="true">↗</span></a>
  </section></Layout>
